{
  "name": "explainer-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:nabra && vite --host 0.0.0.0",
    "build": "npm run build:nabra && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:nabra": "tsup --config vendor/nabra-tts/tsup.config.ts && node scripts/copy-nabra-notices.mjs",
    "render:demo": "npm run build:nabra && node scripts/generate-voice-smoke.mjs && node scripts/create-audio-fixture.mjs && remotion render src/video/remotion-entry.tsx ExplainerDemo out/explainer-demo.mp4 --codec=h264 --gl=swangle --concurrency=2",
    "test": "npm run build:nabra && vitest run"
  },
  "dependencies": {
    "@remotion/player": "4.0.547",
    "@remotion/media": "4.0.547",
    "remotion": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@remotion/web-renderer": "4.0.547",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "@remotion/cli": "4.0.547",
    "vitest": "4.1.0",
    "ffprobe-static": "3.1.0",
    "tsup": "8.5.1",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0"
  }
}
