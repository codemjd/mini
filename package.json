{
  "name": "spark-workshop-mini",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@melonjs/tiled-inflate-plugin": "1.2.2",
    "melonjs": "20.15.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@melonjs/capacitor-plugin": "1.0.2",
    "@melonjs/debug-plugin": "16.2.1",
    "@melonjs/gamepad-plugin": "1.2.2"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "@playwright/test": "^1.56.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2"
  }
}
